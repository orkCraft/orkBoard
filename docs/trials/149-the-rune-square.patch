+            super().__init__()
+            self.allocated = None
+            for g in self.parties:
+                for key in ("next_element", "next_hue", "next_hues", "free_elements"):
+                    g[key] = snapshot[key]
+
+        def handle(self, name, args):
+            if name == "ideas.add":
+                self.log.append((name, args))
+                self.allocated = real.command(name, {**args, "party": party, "hold": True})
