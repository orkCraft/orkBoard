diff --git a/orkboard/gui/static/js/table/feedwaits.js b/orkboard/gui/static/js/table/feedwaits.js
new file mode 100644
index 0000000..0f215ab
--- /dev/null
+++ b/orkboard/gui/static/js/table/feedwaits.js
@@ -0,0 +1,17 @@
+// What waits for the person, read from the host's `ideas.feed` (realm/board_feed.py `waits`; goal 170 stage D, decisions §293.2): asked **once a refresh of the Board** by the page (no new host command), the specs that start by themselves at a clock time
+// (`kind` "starts": its goal, its leader, its clock time and its acts, each the command the reader names). The goals done and waiting for main (`kind` "main") are the discard's and are not read here. Nothing is sorted or counted: the reader's order is kept.
+import { useEffect, useRef, useState } from "preact/hooks";
+import { command } from "../link.js";
+import { currentProject } from "../shell/projects.js";
+import { mapData } from "../shell/store.js";
+
+/** `[waits, reload]`: the reader's *starts* waits in its order, read again whenever the Board is read again (`mapData`) or the project changes; a refusal keeps what was drawn. */
+export function useWaits() {
+  const [got, setGot] = useState([]), n = useRef(0), project = currentProject.value?.path || "", board = mapData.value;
+  const load = () => {
+    const k = ++n.current;
+    command("ideas.feed", {}, true).then((r) => { if (k === n.current) setGot((Array.isArray(r?.waits) ? r.waits : []).filter((w) => w.kind === "starts")); }).catch(() => {});
+  };
+  useEffect(() => { load(); }, [project, board]);
+  return [got, load];
+}
