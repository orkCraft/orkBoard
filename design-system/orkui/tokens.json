{
  "name": "orkUI",
  "look": "office",
  "version": "0.10.0",
  "note": "The source of office/tokens.css (python tools/build_tokens.py). Dark only. Colour means a signal, except the one ork green of the primary action and the table's wood, a surface and never a mark (decisions §53.5 of orkboard). A long text read through (a spec, a document) lies on the paper in the reading ink and the reading face (.ork-read): a step below full ink, about 10:1, so a page does not glare.",
  "color": {
    "canvas": "#0b0b0b",
    "panel": "#111111",
    "raised": "#1a1a1a",
    "paper": "#141414",
    "frame": "#333333",
    "edge": "#8a8a8a",
    "ink": "#e8e8e8",
    "ink-muted": "#9a9a9a",
    "ink-faint": "#858585",
    "ink-read": "#c4c4c4",
    "on-ink": "#0b0b0b",
    "action": "#6aa84f",
    "action-hi": "#7fbf5f",
    "action-press": "#58903f",
    "danger": "#f5806e",
    "alert": "#f0d050",
    "warning": "#f0d050",
    "success": "#86c062",
    "elem-meadow": "#7fbf9a",
    "elem-ice": "#82aaff",
    "elem-dust": "#d4b77a",
    "elem-void": "#8e88a8",
    "elem-lava": "#a49a96",
    "table": "#16110d",
    "table-rim": "#4e3a2c",
    "table-rim-hi": "#7a5d49"
  },
  "text_pairs": [
    ["ink", "canvas"], ["ink", "panel"], ["ink", "raised"],
    ["ink-muted", "canvas"], ["ink-muted", "panel"], ["ink-muted", "raised"],
    ["ink-faint", "canvas"], ["ink-faint", "panel"], ["ink-faint", "raised"],
    ["danger", "canvas"], ["danger", "panel"], ["danger", "raised"],
    ["alert", "canvas"], ["alert", "panel"], ["alert", "raised"],
    ["success", "canvas"], ["success", "panel"], ["success", "raised"],
    ["on-ink", "ink"], ["on-ink", "action"], ["on-ink", "action-hi"], ["on-ink", "action-press"],
    ["on-ink", "danger"], ["on-ink", "alert"], ["on-ink", "ink-muted"],
    ["action", "panel"],
    ["ink", "table"], ["ink-muted", "table"], ["ink-faint", "table"], ["danger", "table"], ["alert", "table"], ["success", "table"],
    ["ink-read", "paper"], ["ink-read", "canvas"], ["ink", "paper"], ["ink-muted", "paper"], ["ink-faint", "paper"], ["danger", "paper"], ["alert", "paper"], ["success", "paper"]
  ],
  "edge_pairs": [["edge", "canvas"], ["edge", "panel"], ["edge", "raised"], ["ink", "canvas"], ["edge", "table"], ["edge", "paper"]],
  "font": {
    "pixel": "\"Pixelify Sans\", \"IBM Plex Mono\", ui-monospace, monospace",
    "text": "\"IBM Plex Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "read": "\"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "code": "var(--ork-font-text)"
  },
  "type": {
    "title":   {"family": "pixel", "weight": 500, "size": 16, "line": 20, "caps": true, "track": "0.04em"},
    "heading": {"family": "pixel", "weight": 500, "size": 14, "line": 16, "caps": true, "track": "0.04em"},
    "label":   {"family": "pixel", "weight": 500, "size": 12, "line": 16, "caps": true, "track": "0.06em"},
    "button":  {"family": "pixel", "weight": 500, "size": 13, "line": 16, "caps": false, "track": "0"},
    "body":    {"family": "text",  "weight": 400, "size": 12, "line": 18, "caps": false, "track": "0"},
    "caption": {"family": "text",  "weight": 400, "size": 11, "line": 16, "caps": false, "track": "0"},
    "read":    {"family": "read",  "weight": 400, "size": 15, "line": 26, "caps": false, "track": "0"}
  },
  "phone_type": {
    "heading": {"family": "pixel", "weight": 500, "size": 16, "line": 20},
    "button":  {"family": "pixel", "weight": 500, "size": 16, "line": 20},
    "label":   {"family": "pixel", "weight": 500, "size": 14, "line": 16},
    "body":    {"family": "text",  "weight": 400, "size": 16, "line": 22},
    "caption": {"family": "text",  "weight": 400, "size": 13, "line": 18},
    "read":    {"family": "read",  "weight": 400, "size": 17, "line": 28}
  },
  "space": {"1": 2, "2": 4, "3": 6, "4": 8, "5": 12, "6": 16, "8": 24},
  "size": {"control": 24, "chip": 20, "bar": 32, "row": 28, "icon": 24, "tap": 44, "touch-draw": 40, "tabbar": 56, "keyline": 24},
  "shape": {"line": 1, "radius": 0, "notch": 2, "double": 3},
