    "hut-frame": "edge", "frame-strong": "edge", "frame-focus": "ink", "ink": "ink", "ink-muted": "ink-muted",
    "ink-comment": "ink-faint", "ink-gold": "ink", "action": "action", "on-action": "on-ink", "alert": "alert",
    "alert-hot": "danger", "fire-glow": "alert", "fire-ember": "danger", "fire-ground": "panel",
    "fire-ground-hot": "panel", "success": "success", "danger": "danger", "warning": "warning", "info": "ink",
    "unit-active": "ink", "unit-alert": "danger", "signal-ask": "alert", "signal-fire": "danger",
    "signal-held": "ink-muted", "chip": "raised", "chip-ink": "ink", "parchment": "raised", "parchment-ink": "ink",
    "walnut": "frame", "accent-teal": "raised", "kit-wood": "frame", "kit-wood-light": "frame",
    "kit-wood-dark": "canvas", "kit-wood-hover": "raised", "kit-teal-light": "raised", "kit-teal-dark": "canvas",
    "kit-teal-hover": "raised", "kit-parchment-deep": "panel", "kit-parchment-rule": "frame", "kit-ink": "ink",
    "road": "edge", "road-bright": "edge", "road-selected": "ink", "road-live": "ink", "cart-filtered": "ink-faint",
    "cart-held": "alert", "cart-error": "danger", "day": "edge", "day-quiet": "frame", "day-office": "frame",
    "quiet-ink": "ink-muted", "tier-elder": "ink", "tier-warrior": "ink-muted", "tier-laborer": "ink-faint",
    "meter": "ink", "sticky-yellow": "panel", "sticky-green": "panel", "sticky-blue": "panel", "sticky-red": "panel",
    "sticky-purple": "panel", "mark-yellow": "alert", "mark-green": "success", "mark-blue": "ink",
    "mark-red": "danger", "mark-purple": "ink-muted", "pr-merged": "ink-muted", "wood": "frame", "bone": "ink",
    "cloth": "raised", "ink-wood": "ink", "art-wood": "frame", "art-wood-light": "edge", "art-wood-dark": "frame",
    "art-wood-deep": "frame", "art-stone": "edge", "art-stone-dark": "frame", "art-iron": "frame",
    "art-bone": "ink-muted", "art-cloth": "raised", "art-cloth-plum": "raised", "art-skin": "ink-muted",
    "art-outline": "canvas", "world-grass": "canvas", "world-grass-light": "canvas", "world-grass-dark": "canvas",
    "world-earth": "panel", "world-earth-dark": "panel", "world-water": "canvas", "world-water-dark": "canvas"
  },
  "legacy_literal": {
    "harness-claude": "#f59e0b", "harness-agy": "#7fb0e0", "harness-codex": "#3fbf8f", "harness-hermes": "#c4a3f0",
    "harness-pi": "#ef7f97", "harness-cursor": "#b8c2d0", "harness-pipeline": "#d996dd",
    "bevel-raised": "none", "bevel-sunken": "inset 0 0 0 1px var(--ork-frame)", "card-edge": "0 0 0 0 transparent",
    "shadow-window": "0 0 0 1px var(--ork-edge)", "glow-fire": "0 0 0 1px var(--ork-alert)"
  },
  "legacy_misc": {
    "space-1": "4px", "space-2": "8px", "space-3": "12px", "space-4": "16px", "space-6": "24px", "space-8": "32px",
    "radius-0": "0px", "radius-sm": "0px", "radius-md": "0px", "radius-lg": "0px", "radius-full": "0px",
    "ok-radius": "0px", "ok-radius-md": "0px", "ok-radius-lg": "0px", "ok-stroke": "1px", "ok-frame": "1px",
    "ok-control": "24px", "ok-pad": "8px", "ok-case": "none", "ok-track": "0", "ok-body": "12px",
    "ok-font": "var(--ork-font-text)", "ok-head": "var(--ork-font-pixel)",
    "font-office": "var(--ork-font-text)", "font-camp": "var(--ork-font-text)", "font-mono": "var(--ork-font-code)",
    "font-pixel": "var(--ork-font-pixel)", "font-kit": "var(--ork-font-pixel)", "font-display": "var(--ork-font-pixel)",
    "border-hair": "1px", "border-bevel": "1px", "border-frame": "1px", "control-office": "24px",
    "control-camp": "24px", "titlebar": "32px", "bar-hud": "32px", "chip-h": "20px", "chip-h-touch": "28px",
    "tap-min": "44px"
  }
